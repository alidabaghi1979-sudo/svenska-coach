# ─── Svenska Daily Lesson — copy to .env and fill in ───────────────
# NEVER commit .env (it is in .gitignore). On GitHub use repo Secrets.
#
# Running locally inside Svenska Coach? Then these are read automatically from
# ../.streamlit/secrets.toml and you can leave them empty here:
#   LLM_API_KEY (from [claude] / [gemini]), GDRIVE_* (from [gdrive_oauth]),
#   SVENSKA_SHEET_ID (svenska_sheet_id), service account ([gcp_service_account]).
# You then only need TTS_API_KEY.

# ── LLM ──────────────────────────────────────────────
# claude | gemini | openai
LLM_PROVIDER=claude
LLM_API_KEY=sk-ant-...
# Optional: override default model for the provider
#   claude default: claude-sonnet-5
#   gemini default: gemini-2.5-flash
#   openai default: gpt-4.1-mini
LLM_MODEL=

# ── TTS ──────────────────────────────────────────────
# azure | elevenlabs
TTS_PROVIDER=azure
TTS_API_KEY=
# Azure only: region of your Speech resource (e.g. swedencentral, westeurope)
AZURE_SPEECH_REGION=swedencentral
# narrator = podcast host, male/female = the two people in the dialogue
AZURE_VOICE_NARRATOR=sv-SE-SofieNeural
AZURE_VOICE_MALE=sv-SE-MattiasNeural
AZURE_VOICE_FEMALE=sv-SE-HilleviNeural
# ElevenLabs only: voice IDs from your ElevenLabs voice library
# (male/female fall back to the narrator voice if empty)
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_MALE=
ELEVENLABS_VOICE_FEMALE=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Speaking rate for learners (1.0 = normal)
SPEAKING_RATE=0.95

# ── Lesson settings ─────────────────────────────────
# Your level; the generator adapts language to this
TARGET_LEVEL=A2-B1
# weekday = follow the weekly cycle (Mon/Wed/Fri vardag, Tue/Thu arbete, Sat SFI-prov, Sun fritt)
# sequential = just take the next topic in curriculum.json
TOPIC_MODE=weekday
TIMEZONE=Europe/Stockholm

# ── Google Drive upload (optional) ───────────────────
# Same values as the [gdrive_oauth] block from oauth_setup.py
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER_NAME=Svenska Daily Lessons

# ── Svenska Coach app (Google Sheets) ──────────────────
# Sheet ID of "Ali Svenska Journal" (same as svenska_sheet_id in secrets.toml)
SVENSKA_SHEET_ID=
# The whole service-account JSON on ONE line (GitHub secret). Locally: leave empty.
GCP_SERVICE_ACCOUNT_JSON=
# 1 = add each lesson's words to the app's ordbank (SRS review), 0 = don't
ADD_VOCAB_TO_ORDBANK=1

# ── Misc ─────────────────────────────────────────────
DATA_DIR=data
LOG_LEVEL=INFO
